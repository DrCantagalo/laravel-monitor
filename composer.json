{
    "name": "drcantagalo/laravel-monitor",
    "description": "A lightweight Laravel package providing CRM tools, access monitoring, and anti-scraper protection. Requires Laravel's Cache facade (any driver).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michel Cantagalo",
            "email": "cantagalo@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Drcantagalo\\LaravelMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drcantagalo\\LaravelMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Drcantagalo\\LaravelMonitor\\MonitorServiceProvider"
            ],
            "aliases": {
                "Monitor": "Drcantagalo\\LaravelMonitor\\Facades\\Monitor"
            }
        }
    }
}